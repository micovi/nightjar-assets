// NightCash — the sale policies: how somebody who is not the issuer comes to hold NC.
//
// There is no "mint policy" and this file is where to say so. Minting is not a note policy at
// all: an issuance proves, inside the transition, knowledge of `issuer_ak`, `collection_label`,
// `label` and `terms` hashing to `asset_id`, plus a spend-authorization signature under a
// randomized `issuer_ak` (`spec/note-format-v0.md` section 8). The right to mint is a *key the
// issuer holds*, not a clause anybody can read off a note, and there is nowhere in a policy to
// write it down. What a policy can govern is the note the issuer puts up for sale — which is
// what the two notes below are.
//
// Both are the policies the shipped CLI builds, not designs invented for this repository:
// `programs::reservation_policy` (`crates/nyctis-cli/src/programs.rs:223`) and
// `programs::offer_policy` (`:282`). `scripts/devnet-programs.sh` in the Nyctis repository is
// the end-to-end that exercises both against a running node.

// ---------------------------------------------------------------------------------------------
// 1. Reservation — a lot for ZEC, from a named buyer. `wallet sell` / `wallet buy`.
//
//     pk(S) && after(h_exp) || (pk(B) && zec(H_order, price))
//
// Both halves were missing from the first shipped `sell`, and each absence was a way to lose
// money (F5).
//
//   * `pk(buyer)` **names the buyer**. ZEC never enters Nyctis and this protocol cannot refuse
//     a Zcash payment. On an openly fillable order two buyers filling in the same block both pay
//     while only the lower `(height, tx_index)` is applied — the loser forfeits the whole price,
//     not a fee. Naming the buyer removes the race, because only the buyer can consume the note.
//     There is no openly fillable form of this order; `wallet sell` requires `--buyer`.
//   * `after(expires)` **time-locks the seller's cancel**. A channel's viewing key is published,
//     so a pending fill is readable in the mempool. With an untimelocked `pk(seller)` branch the
//     seller reads the buyer's payment, self-spends at a higher fee, and keeps the lot *and* the
//     ZEC.
//
// `seller` and `till` are the **per-order** identity and not the maker's account. `wallet sell`
// derives a fresh key and a dedicated Ironwood account for each order, and
// `programs::check_no_account_identity` refuses to publish an order that carries the account's
// own `ak` or viewing key — the `NOTE` message broadcasts the policy verbatim, so an
// account-level `pk()` leaf would put two thirds of the maker's address in the clear (F14), and
// an account-level `zec()` leaf would hand every reader of the channel the incoming viewing key
// to the maker's whole Zcash history, past and future (F16).
//
// Quantity needs no bound here: `buy` consumes the note whole and there is no remainder
// covenant, so the "one lot's price buys the inventory" shape cannot arise
// (`spec/policy-codec-v0.md` section 10.1).

note Reservation(seller: Key, buyer: Key, till: Account, price: Zec = 0.5 zec, expires: Height = 2027-06-01) {
  cancel { by seller; after expires }
  buy    { by buyer; paid price to till }
}

check "the named buyer pays and takes the lot" {
  spend Reservation()
  amount 100000000000
  as buyer
  paid 0.5 zec to till
  expect buy
}

check "one zatoshi short" {
  spend Reservation()
  amount 100000000000
  as buyer
  paid 49999999 zat to till
  expect cannot
}

// F5, stated as a test: somebody else with the money still cannot take the lot.
check "somebody else, with the money, still cannot" {
  spend Reservation()
  amount 100000000000
  as nobody
  paid 0.5 zec to till
  expect cannot
}

// F5 again, the other half: the seller cannot cancel out from under a buyer who is paying.
check "the seller cannot cancel while the reservation stands" {
  spend Reservation()
  amount 100000000000
  as seller
  at 2027-05-31
  expect cannot
}

check "the seller reclaims an unsold lot after the expiry" {
  spend Reservation()
  amount 100000000000
  as seller
  at 2027-06-02
  expect cancel
}

// ---------------------------------------------------------------------------------------------
// 2. Offer — part of a lot, asset for asset, open to anyone. `wallet offer` / `wallet fill`.
//
// This is the shape a fungible asset can have and a unique one cannot: a lot of one cannot be
// split, so `pon/sale.roost` has no counterpart to this note.
//
// Unlike the reservation it needs no named taker and no timelock on the maker's branch: a
// Nyctis transition is atomic, so a filler whose fill is ignored has spent nothing. Nothing
// here can be raced away.
//
// Two pinned fields are the whole reason this is safe, and each was a bug first.
//
//   * the payout's `data` is pinned to `0`, not left open (F3). It is `recoverable`, which means
//     the maker rebuilds it from public data with no ciphertext from the taker — but recovery
//     only works if *every* field of the commitment is determined. With `data` open, a taker who
//     paid the exact price could set it to a random field element: the covenant is satisfied,
//     the taker is out exactly what an honest taker is out, and the maker is left searching
//     2^253 values for the commitment of their own money. Roost pins it for you and refuses the
//     covenant otherwise (`E_RECOVERABLE_DETERMINED`); look for `.data(== 0)` in the report.
//   * the remainder is `amount == self - out 0`, pinned and `recoverable` (N3) — the maker's
//     unsold inventory is not a courtesy the taker may withhold. It used to be `amount < self`
//     with `data` open and no flag, which is F3 again pointed at the larger number: the taker
//     chose the remainder's randomness and data, so the goods that did *not* sell came back only
//     if the taker volunteered a `NOTE` publication that nothing compels and whose withholding
//     is economically identical to an honest fill.
//
// `amount < self` could not simply be flagged `recoverable`: `< self` is a ceiling, not a floor
// the maker can scan up from, so `E_RECOVERABLE_DETERMINED` refuses it. Try it and read the
// error. `== self - out 0` is the form that fits the layout `fill` builds — `[taken, remainder,
// payout]` — where output 0 is the quantity taken.
//
// What it gives up: `< self` forced at least one unit to move. Nothing now stops a taker
// building `out 0` with amount 0, taking nothing, paying nothing, and churning the offer to a
// fresh position for the price of a Zcash fee. No value moves and the new note is as recoverable
// as the old one, so it is a nuisance rather than a loss.

note Offer(maker: Address, want: Asset, price: Ratio = 250) {
  cancel { by maker }
  fill {
    out any { to maker; asset want; amount >= (self - out 1) * price; recoverable }
    out 1   { to self; amount == self - out 0; recoverable }
  }
}

check "a taker fills 4 of 10 and pays 1000" {
  spend Offer()
  amount 10
  as nobody
  inputs 2
  out 0: 4
  out 1: 6 self
  out 2: 1000 to maker asset want
  expect fill
}

check "paying one short of the rate" {
  spend Offer()
  amount 10
  as nobody
  inputs 2
  out 0: 4
  out 1: 6 self
  out 2: 999 to maker asset want
  expect cannot
}

// N3, as a test: the remainder is not optional. A taker who pays correctly but keeps the unsold
// six does not have a fill.
check "a taker who pays but leaves no remainder" {
  spend Offer()
  amount 10
  as nobody
  inputs 2
  out 0: 4
  out 2: 1000 to maker asset want
  expect cannot
}

// The fill needs no signature from anybody: the taker acquires the goods by conservation.
check "the maker withdraws what is left" {
  spend Offer()
  amount 10
  as maker
  expect cancel
}
